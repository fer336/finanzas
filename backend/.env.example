# ==================================================================
# SISTEMA DE GASTOS - BACKEND ENVIRONMENT VARIABLES
# ==================================================================
# Copia este archivo como .env y completa con tus valores reales
# cp .env.example .env
# ==================================================================

# ------------------------------
# ENVIRONMENT
# ------------------------------
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------
# SECRET KEYS
# ------------------------------
# Generar con: openssl rand -hex 32
SECRET_KEY=tu_secret_key_super_seguro_cambiar_en_produccion
SESSION_SECRET_KEY=tu_session_secret_key_cambiar_en_produccion

# ------------------------------
# POSTGRESQL DATABASE
# ------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password_seguro
POSTGRES_DB=sistema_financiero

# ------------------------------
# GOOGLE OAUTH2
# ------------------------------
# Obtén tus credenciales en: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-tu_client_secret_aqui

# ------------------------------
# URLS
# ------------------------------
DEV_FRONTEND_URL=http://localhost:5173
DEV_BACKEND_URL=http://localhost:8000
PRODUCTION_FRONTEND_URL=https://tu-dominio.com
PRODUCTION_BACKEND_URL=https://tu-dominio.com

# ------------------------------
# MINIO CONFIGURATION
# ------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=tu_minio_secret_key_cambiar
MINIO_BUCKET_NAME=comprobantes
MINIO_SECURE=false
MINIO_REGION=us-east-1

# ------------------------------
# CORS
# ------------------------------
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
CORS_CREDENTIALS=true

# ------------------------------
# AUTHORIZED EMAILS
# ------------------------------
# Lista de emails autorizados separados por coma
AUTHORIZED_EMAILS=tu_email@example.com

# ------------------------------
# TOKEN EXPIRATION
# ------------------------------
# Tiempo de expiración del token en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------
# OPENROUTER API (Agente IA)
# ------------------------------
# Obtén tu API key en: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------
# NOTAS IMPORTANTES
# ------------------------------
# ⚠️  NUNCA subas el archivo .env a GitHub
# ⚠️  Cambia todas las claves secretas en producción
# ⚠️  Usa contraseñas seguras (mínimo 16 caracteres)
# ⚠️  Mantén las API keys privadas
