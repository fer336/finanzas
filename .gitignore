# Scripts y configuraciones de deployment (contienen información sensible)
deploy-production.sh
update-production.sh
docker-compose.yml
docker-compose.yml.bak

# ===================================
# INSTRUCCIONES IMPORTANTES:
# 
# ✅ SIEMPRE INCLUIR:
# - env.template (plantilla sin credenciales)
# - env.example (plantilla sin credenciales)
# - README.md (documentación)
# 
# ❌ NUNCA INCLUIR:
# - .env (contiene credenciales reales)
# - archivos con tokens/passwords
# - claves privadas
# ===================================