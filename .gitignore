# ===================================
# GITIGNORE - SISTEMA DE GASTOS
# ===================================

# 🔒 ARCHIVOS SENSIBLES - NUNCA SUBIR A GITHUB
# ===================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example
!.env.template

# Bloquear archivos sin el punto inicial (posibles errores)
**/env.example
**/env.template
**/ENV.example

# Credenciales y configuraciones privadas
config/secrets.json
config/credentials.json
*.pem
*.key
*.crt

# 📁 DEPENDENCIAS
# ===================================
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock
.pnpm-debug.log*

# Python
__pycache__/
*/__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# 🏗️ BUILD Y DISTRIBUCIÓN
# ===================================
build/
dist/
.next/
out/
.nuxt/
.cache/
public/build/

# 🧪 TESTING
# ===================================
coverage/
.nyc_output/
*.lcov
.jest/

# TestSprite - Archivos temporales
testsprite_tests/tmp/
testsprite_tests/**/*.lock
testsprite_tests/**/execution.lock
testsprite_tests/**/config.json

# TestSprite - Incluir planes de prueba y reportes
!testsprite_tests/*_test_plan.json
!testsprite_tests/TC*-*.md
!testsprite_tests/standard_prd.json

# 📝 LOGS
# ===================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# 💾 BASES DE DATOS LOCALES
# ===================================
*.db
*.sqlite
*.sqlite3
*.db-journal

# 🔧 HERRAMIENTAS DE DESARROLLO
