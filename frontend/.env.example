# ==================================================================
# SISTEMA DE GASTOS - FRONTEND ENVIRONMENT VARIABLES
# ==================================================================
# Copia este archivo como .env y completa con tus valores reales
# cp .env.example .env
# ==================================================================

# ------------------------------
# VITE CONFIGURATION
# ------------------------------
# Vite requiere que las variables empiecen con VITE_
WDS_SOCKET_PORT=0

# ------------------------------
# GOOGLE OAUTH CLIENT ID
# ------------------------------
# Debe coincidir con el backend
# Obtén tu Client ID en: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com

# ------------------------------
# BACKEND URLS
# ------------------------------
# Desarrollo
VITE_DEV_BACKEND_URL=http://localhost:8000
VITE_DEV_FRONTEND_URL=http://localhost:5173
VITE_OAUTH_DEV_URL=http://localhost:8000/auth/google/dev

# Producción
VITE_BACKEND_URL=https://tu-dominio.com
VITE_OAUTH_PROD_URL=https://tu-dominio.com/auth/google

# ------------------------------
# DEBUG MODE
# ------------------------------
VITE_DEBUG=true

# ------------------------------
# OPTIONAL: FEATURE FLAGS
# ------------------------------
# VITE_ENABLE_AI_AGENT=true
# VITE_ENABLE_CEDEARS=true
# VITE_ENABLE_BUDGETS=true

# ------------------------------
# OPTIONAL: ANALYTICS
# ------------------------------
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX
# VITE_SENTRY_DSN=https://xxxxxx@sentry.io/xxxxxx

# ------------------------------
# NOTAS IMPORTANTES
# ------------------------------
# ⚠️  Las variables VITE_ son públicas (se compilan en el bundle)
# ⚠️  NO pongas secretos o API keys privadas aquí
# ⚠️  Solo el Client ID de Google OAuth es seguro exponer
# ⚠️  Reinicia el servidor después de cambiar .env (npm run dev)
