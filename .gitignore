.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# 🐳 DOCKER
# ===================================
.dockerignore
docker-compose.override.yml

# 📱 MOBILE
# ===================================
.expo/
.expo-shared/

# 🖥️ SISTEMA OPERATIVO
# ===================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 🔄 TEMPORALES
